---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SECTIONS } from '../../lib/sections';

export async function getStaticPaths() {
  return Object.keys(SECTIONS).map((section) => ({ params: { section } }));
}

const { section } = Astro.params;
const entries = await getCollection(
  section as any,
  ({ data }: any) => import.meta.env.DEV || data.status === 'published'
);
const sorted = entries.sort(
  (a: any, b: any) => (a.data.order ?? 999) - (b.data.order ?? 999)
);
const base = import.meta.env.BASE_URL;
const label = SECTIONS[section as keyof typeof SECTIONS];
---
<Base title={label}>
  <h1>{label}</h1>
  {section === 'departments' && (
    <p>
      <a href={`${base}departments-map/`}>索引・比較表(主戦場/検証リスク水準/着手のしやすさ)</a>
      — 部門間の相対位置づけはこの比較表で一覧できる。
    </p>
  )}
  {sorted.length === 0 && <p><em>コンテンツ準備中です。</em></p>}
  <ul class="article-list">
    {sorted.map((entry: any) => (
      <li>
        <a href={`${base}${section}/${entry.id}/`}>
          {entry.data.title}
          {entry.data.status !== 'published' && <span class="badge">{entry.data.status}</span>}
        </a>
        <p class="summary">{entry.data.summary}</p>
      </li>
    ))}
  </ul>
  <style>
    .article-list { list-style: none; padding: 0; }
    .article-list li { margin-bottom: 1.5rem; }
    .article-list a { font-weight: 600; font-size: 1.05rem; }
    .summary { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.9rem; }
    .badge {
      font-size: 0.7rem;
      background: #b3540030;
      border-radius: 4px;
      padding: 0.1rem 0.4rem;
      margin-left: 0.5rem;
    }
  </style>
</Base>
