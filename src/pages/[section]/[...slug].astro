---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SECTIONS } from '../../lib/sections';

export async function getStaticPaths() {
  const sections = [
    'principles',
    'readiness',
    'organization',
    'roadmap',
    'departments',
    'patterns',
    'anti-patterns',
  ];
  const paths = [];
  for (const section of sections) {
    // draft / review は開発時のみ表示。公開ビルドには published だけが入る
    const entries = await getCollection(
      section as any,
      ({ data }: any) => import.meta.env.DEV || data.status === 'published'
    );
    for (const entry of entries) {
      paths.push({ params: { section, slug: entry.id }, props: { entry, section } });
    }
  }
  return paths;
}

const { entry, section } = Astro.props as any;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const sectionLabel = SECTIONS[section as keyof typeof SECTIONS] ?? section;

// frontmatterのid参照(related/escape、patternsのdepartments)を関連ページリンクに解決する
const ALL_SECTIONS = Object.keys(SECTIONS);
async function findBySlug(slug: string) {
  for (const s of ALL_SECTIONS) {
    const hits = await getCollection(
      s as any,
      ({ id, data }: any) => id === slug && (import.meta.env.DEV || data.status === 'published')
    );
    if (hits.length) return { section: s, entry: hits[0] };
  }
  return null;
}
const relatedIds: string[] = [
  ...((entry.data as any).related ?? []),
  ...((entry.data as any).escape ?? []),
  ...(section === 'patterns'
    ? ((entry.data as any).departments ?? []).filter((d: string) => d !== 'all')
    : []),
];
const relatedPages = (await Promise.all([...new Set(relatedIds)].map(findBySlug))).filter(Boolean);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <nav class="breadcrumb">
    <a href={base}>ホーム</a> › <a href={`${base}${section}/`}>{sectionLabel}</a>
  </nav>
  {entry.data.status !== 'published' && (
    <p class="draft-banner">⚠ このページは下書き({entry.data.status})です。公開ビルドには含まれません。</p>
  )}
  <h1>{entry.data.title}</h1>
  <aside class="exec-summary">
    <strong>要点</strong>
    <p>{entry.data.summary}</p>
  </aside>
  <Content />
  {relatedPages.length > 0 && (
    <nav class="related-pages">
      <h2>関連ページ</h2>
      <ul>
        {relatedPages.map((p: any) => (
          <li>
            <a href={`${base}${p.section}/${p.entry.id}/`}>
              {SECTIONS[p.section as keyof typeof SECTIONS]}「{p.entry.data.title.split(' — ')[0]}」
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  <footer class="article-meta">
    <p>
      最終更新: {entry.data.updated.toISOString().slice(0, 10)} ／
      次回レビュー期限: {entry.data.review_by.toISOString().slice(0, 10)}
    </p>
    {entry.data.sources.length > 0 && (
      <p>出典: {entry.data.sources.map((s: string) => <code>{s} </code>)}</p>
    )}
  </footer>
  <style>
    .breadcrumb { font-size: 0.85rem; color: var(--muted); }
    .draft-banner {
      background: #b3540020;
      border: 1px solid #b35400;
      border-radius: 6px;
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
    }
    .exec-summary {
      border-left: 4px solid var(--accent);
      padding: 0.5rem 1rem;
      margin: 1.5rem 0;
      background: color-mix(in srgb, var(--accent) 5%, transparent);
    }
    .exec-summary p { margin: 0.25rem 0 0; }
    .related-pages {
      margin-top: 2.5rem;
      padding: 0.75rem 1.25rem;
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    .related-pages h2 { font-size: 1rem; margin: 0.25rem 0 0.5rem; }
    .related-pages ul { margin: 0; padding-left: 1.25rem; font-size: 0.9rem; }
    .article-meta {
      margin-top: 3rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      font-size: 0.8rem;
      color: var(--muted);
    }
  </style>
</Base>
